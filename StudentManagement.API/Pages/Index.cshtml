<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ Thống Quản Lý Sinh Viên</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="container">
    <header>
        <h1>Hệ Thống Quản Lý Sinh Viên</h1>
    </header>

    <div class="grid">
        <!-- FORM THÊM / CẬP NHẬT -->
        <div class="card">
            <h2 id="formTitle">Thêm Sinh Viên Mới</h2>
            <form id="studentForm">
                <div class="form-group">
                    <label for="id">Mã Sinh Viên</label>
                    <input type="text" id="id" required placeholder="VD: SV001">
                </div>
                <div class="form-group">
                    <label for="fullName">Họ và Tên</label>
                    <input type="text" id="fullName" required placeholder="VD: Nguyen Van A">
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" required placeholder="VD: vana@gmail.com">
                </div>
                <div class="form-group">
                    <label for="dateOfBirth">Ngày Sinh</label>
                    <input type="date" id="dateOfBirth" required>
                </div>
                <div class="form-group">
                    <label for="gpa">Điểm GPA (0.0 - 4.0)</label>
                    <input type="number" step="0.1" min="0" max="4" id="gpa" required placeholder="VD: 3.8">
                </div>

                <button type="submit" class="btn" id="submitBtn">Lưu Sinh Viên</button>
                <button type="button" class="btn btn-cancel" id="cancelBtn" style="display: none;" onclick="resetForm()">Hủy Chỉnh Sửa</button>
                <div id="statusMsg" class="status-msg"></div>
            </form>
        </div>

        <!-- BẢNG DANH SÁCH SINH VIÊN -->
        <div class="card">
            <h2>Danh Sách Sinh Viên</h2>
            <table>
                <thead>
                    <tr>
                        <th>Mã SV</th>
                        <th>Họ Tên</th>
                        <th>Email</th>
                        <th>Ngày Sinh</th>
                        <th>GPA</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="studentTableBody">
                    <tr><td colspan="6" style="text-align: center;">Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="/js/app.js"></script>
</body>
</html>